                                            </StackPanel>


                                            <Border BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" CornerRadius="7" Margin="0 8">
                                                <DockPanel VerticalAlignment="Center" MinHeight="30" Margin="8 4">
                                                    <Image Source="{Binding ProgramIcon}" d:Source="{DynamicResource KeyImageImg_2}" Width="24" Height="24" Margin="0 0 8 0" />
                                                    <TextBlock Text="{Binding ProgramName}" d:Text="Sample Program Name Sample Program Name Name Sample Program Name" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="{Binding Filepath}" />
                                                </DockPanel>
                                            </Border>

                                            <StackPanel Orientation="Vertical">
                                                <Label Content="Launch options/Arguments" Height="24"/>
                                                <TextBox Text="{Binding Arguments}" MinHeight="24"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>
                                </TabItem>
                                
                                <TabItem x:Name="loadProfileTab" Header="Load Profile">
                                    <GroupBox Header="Load a profile">
                                        <StackPanel Orientation="Vertical">
                                            <DockPanel MinHeight="30" LastChildFill="True" Margin="0 4">
                                                <ComboBox SelectedIndex="{Binding ProfileIndex,FallbackValue=0}" Width="Auto" >
                                                    <ComboBox.Resources>
                                                        <DataTemplate DataType="{x:Type ComboBoxItem}">
                                                            <TextBlock Text="{Binding Content}" />
                                                        </DataTemplate>

                                                        <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                                            <TextBlock Text="{Binding Name}" />
                                                        </DataTemplate>
                                                        <CollectionViewSource x:Key="profileListViewSource" Source="{Binding ProfileList.ProfileListCol,Mode=OneWay}" />
                                                    </ComboBox.Resources>
                                                    <ComboBox.ItemsSource>
                                                        <CompositeCollection>
                                                            <ComboBoxItem Content="(none)"/>
                                                            <CollectionContainer x:Name="profileCollection"
                                                                 Collection="{Binding Source={StaticResource profileListViewSource}}" />
                                                        </CompositeCollection>
                                                    </ComboBox.ItemsSource>
                                                </ComboBox>
                                            </DockPanel>
                                            <DockPanel LastChildFill="True" MinHeight="30" Margin="0 4">
                                                <Button x:Name="loadProfUnloadBtn" Width="Auto" Content="{lex:Loc SpecialActionEdit.SetUnloadTrigger}"
                                                    IsEnabled="{Binding UnloadEnabled}" Click="LoadProfUnloadBtn_Click" />
                                            </DockPanel>
                                            <CheckBox Content="{lex:Loc SpecialActionEdit.UnloadTriggerRelease}" IsChecked="{Binding AutoUntrigger}" Margin="0 8 0 0"/>

                                        </StackPanel>
                                    </GroupBox>
                                </TabItem>
                                
                                <TabItem x:Name="pressKetActTab" Header="Press Key">
                                    <GroupBox Header="{lex:Loc SpecialActionEdit.PressKey}">
                                        <StackPanel Margin="0 4 0 0">
                                            <DockPanel MinHeight="30" LastChildFill="True" Margin="0 4">
                                                <Button x:Name="pressKeySelectBtn" Width="Auto" Content="{Binding DescribeText,FallbackValue={lex:Loc SpecialActionEdit.SelectKey}}" Click="PressKeySelectBtn_Click" />
                                            </DockPanel>
                                            <DockPanel MinHeight="30" LastChildFill="True" Margin="0 4">
                                                <Button x:Name="pressKeyToggleTriggerBtn"
                                                    Width="Auto"
                                                    Content="{lex:Loc SpecialActionEdit.SetUnloadTrigger}"
                                                    Tag="{Binding UnloadError,ValidatesOnNotifyDataErrors=True}"
                                                    Visibility="{Binding ShowToggleControls}"
                                                    Click="PressKeyToggleTriggerBtn_Click" />
                                            </DockPanel>
                                            <StackPanel Visibility="{Binding ShowToggleControls}" Margin="0 4">
                                                <Label Content="{lex:Loc SpecialActionEdit.UntoggleKeyBy}" Height="24"/>
                                                <ComboBox x:Name="pressReleaseKeyCombo" Width="Auto" SelectedIndex="{Binding PressReleaseIndex}">
                                                    <ComboBoxItem Content="{lex:Loc SpecialActionEdit.PressingUnloadTrigger}" />
                                                    <ComboBoxItem Content="{lex:Loc SpecialActionEdit.ReleasingUnloadTrigger}" />
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>
                                </TabItem>
                                
                                <TabItem x:Name="disconnectBTTab" Header="DisBT">
                                    <GroupBox Header="Disconnect Bluetooth">
                                        <StackPanel Orientation="Horizontal" Margin="0 4 0 0" Height="30">
                                            <Label Content="{lex:Loc SpecialActionEdit.HoldFor}" ContentStringFormat="{}{0} "></Label>
                                            <xctk:DecimalUpDown Value="{Binding HoldInterval}" Width="60" Minimum="0" Maximum="60" FormatString= "F2" Increment="0.5" Margin="8 0"/>
                                            <Label Content="seconds" />
                                        </StackPanel>
                                    </GroupBox>
                                </TabItem>
                                
                                <TabItem x:Name="checkBatteryTab" Header="Check Battery">
                                    <GroupBox Header="Check the battery">
                                        <StackPanel Margin="0 4 0 0">
                                            <StackPanel Orientation="Horizontal" Margin="0 4" Height="30">
                                                <Label Content="{lex:Loc SpecialActionEdit.HoldFor}" ContentStringFormat="{}{0} "></Label>
                                                <xctk:DecimalUpDown Value="{Binding HoldInterval}" Width="60" Minimum="0" Maximum="60" FormatString= "F2" Increment="0.5" Margin="8 0"/>
                                                <Label Content="seconds" />
                                            </StackPanel>
                                            <CheckBox Content="{lex:Loc SpecialActionEdit.ViaNotification}" IsChecked="{Binding Notification}"/>
                                            <CheckBox Content="{lex:Loc SpecialActionEdit.ViaLightbar}" IsChecked="{Binding Lightbar}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10 0 0">
                                                <StackPanel HorizontalAlignment="Left" MinWidth="40">
                                                    <Button x:Name="batteryLowColorBtn" Width="20" Height="20" Click="BatteryEmptyColorBtn_Click">
                                                        <Button.Background>
                                                            <SolidColorBrush Color="{Binding EmptyColor,FallbackValue=#FFFF0000}"/>
                                                        </Button.Background>
                                                    </Button>
                                                    <Label Content="0%" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Width="130" Height="20" VerticalAlignment="Top" Focusable="False">
                                                    <Button.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="{Binding EmptyColor,FallbackValue=#FFFF0000}"/>
                                                            <GradientStop Color="{Binding FullColor,FallbackValue=#FF00FF00}" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Button.Background>
                                                </Button>
                                                <StackPanel MinWidth="40">
                                                    <Button x:Name="batteryFullColorBtn" Width="20" Height="20" HorizontalAlignment="Center" Click="BatteryFullColorBtn_Click">
                                                        <Button.Background>
                                                            <SolidColorBrush Color="{Binding FullColor,FallbackValue=#FF00FF00}"/>
                                                        </Button.Background>
                                                    </Button>
                                                    <Label Content="100%" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>
                                </TabItem>
                                
                                <TabItem x:Name="multiActTab" Header="MultiAct">
                                    <GroupBox Header="Multi Trigger">
                                        <StackPanel Margin="0 4">
                                            <Label Content="{lex:Loc SpecialActionEdit.TapTrigger}" Height="24" Margin="0 4 0 0"/>
                                            <Button x:Name="multiTapTrigBtn" Width="Auto" Content="{Binding TapMacroText,FallbackValue={lex:Loc SpecialActionEdit.SelectMacro}}"
                                                    Click="MultiTapTrigBtn_Click" />

                                            <Label Content="{lex:Loc SpecialActionEdit.HoldTrigger}" Height="24" Margin="0 8 0 0"/>
                                            <Button x:Name="multiHoldTapTrigBtn" Width="Auto" Content="{Binding HoldMacroText,FallbackValue={lex:Loc SpecialActionEdit.SelectMacro}}"
                                                    Click="MultiHoldTapTrigBtn_Click" />
                                            <Label Content="{lex:Loc SpecialActionEdit.DoubleTapTrigger}" Height="24" Margin="0 8 0 0"/>
                                            <Button x:Name="multiDoubleTapTrigBtn" Width="Auto" Content="{Binding DoubleTapMacroText,FallbackValue={lex:Loc SpecialActionEdit.SelectMacro}}"
                                                    Click="MultiDoubleTapTrigBtn_Click" />
                                        </StackPanel>
                                    </GroupBox>
                                </TabItem>
                                
                                <TabItem x:Name="sixaxisWheelCalibrateTab" Header="Sixaxis Wheel">
                                    <GroupBox Header="{lex:Loc SpecialActionEdit.SixAxisWheelCalib}">
                                        <StackPanel Orientation="Horizontal" MinHeight="30" Margin="0 4" Height="30">
                                            <Label Content="{lex:Loc HoldFor}" ContentStringFormat="{}{0} "/>
                                            <xctk:DecimalUpDown Value="{Binding HoldInterval}" Width="60" Minimum="0" Maximum="60" FormatString= "F2" Increment="0.5" Margin="8 0"/>
                                            <Label Content="seconds" />
                                        </StackPanel>
                                    </GroupBox>
                                </TabItem>
                                
                                <TabItem x:Name="gyroCalibrateTab" Header="Gyro Calibration">
                                    <GroupBox Header="{lex:Loc SpecialActionedit.CalibrateGyro}">
                                        <StackPanel Orientation="Horizontal" MinHeight="30" Margin="0 4">
                                            <Label Content="{lex:Loc HoldFor}" ContentStringFormat="{}{0} "/>
                                            <xctk:DecimalUpDown Value="{Binding HoldInterval}" Width="60" Minimum="0" Maximum="60" FormatString= "F2" Increment="0.5" Margin="8 0"/>
                                            <Label Content="seconds" />
                                        </StackPanel>
                                    </GroupBox>
                                </TabItem>
                            </TabControl>

                            <Border Style="{DynamicResource BorderStyle}">
                                <StackPanel Orientation="Horizontal" MinHeight="30" HorizontalAlignment="Center">
                                    <Button x:Name="cancelBtn" Content="{lex:Loc Cancel}" Click="CancelBtn_Click" Margin="4,0" Width="100"/>
                                    <Button x:Name="saveBtn" Content="{lex:Loc Save}" Click="SaveBtn_Click" Margin="4,0" Width="100" Style="{DynamicResource ImportantButtonStyle}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </DockPanel>
    </DockPanel>
</UserControl>
