<Window x:Class="DS4WinWPF.DS4Forms.StickCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture=""
        lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Stick Calibration"
        Height="170" Width="300"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource WindowStyle}">
    
    <DockPanel Margin="8" LastChildFill="False">

        <GroupBox Header="Stick Calibration" DockPanel.Dock="Top">
            <TextBlock TextWrapping="Wrap">
            Please move your stick to the sides and release it a few times, then after you are done press Save button.
            </TextBlock>
        </GroupBox>

        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" HorizontalAlignment="Right">
            <Button Content="Cancel"
                Click="CloseButton_OnClick"
                VerticalAlignment="Center"
                Width="80"
                HorizontalAlignment="Center"/>
            <Button HorizontalAlignment="Center"
                VerticalAlignment="Center"
                    Margin="8 0 0 0"
                Width="80"
                Content="Save"
                Click="SaveButton_OnClick"/>
        </StackPanel>
    </DockPanel>
</Window>
