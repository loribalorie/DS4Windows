    <ControlTemplate x:Key="SliderHorizontalThumbTemplate" TargetType="{x:Type Thumb}">
        <Grid HorizontalAlignment="Center" UseLayoutRounding="true" VerticalAlignment="Center">
            <Rectangle x:Name="grip" Fill="{StaticResource AccentColorActive}" Stroke="{StaticResource AccentColor}"
                       StrokeThickness="1" SnapsToDevicePixels="true"
                       Width="8" Height="16" RadiusX="3" RadiusY="3" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="grip" Property="Fill" Value="#DEDEDE"/>
                <Setter TargetName="grip" Property="Stroke" Value="#FF7EB4EA"/>
