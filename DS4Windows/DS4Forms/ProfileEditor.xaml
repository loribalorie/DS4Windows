                                </StackPanel>
                           
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" DockPanel.Dock="Top">
                            <StackPanel HorizontalAlignment="Stretch" Margin="8 0 8 8">
                                <TabControl x:Name="touchOutputTabControl"
                                    Style="{DynamicResource HiddenTabControlStyle}"
                                    SelectedIndex="{Binding TouchpadOutputIndex, FallbackValue='0'}"
                                    BorderBrush="{x:Null}">
                                    <!--As Mouse-->
                                    <TabItem x:Name="Mouse" Header="{lex:Loc Mouse}" Visibility="Collapsed">

                                        <GroupBox Header="Mouse emulation on Touchpad" >
                                            <Grid >
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="30"/>

                                                    <RowDefinition Height="20"/>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="20"/>
                                                    <RowDefinition Height="30"/>

                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="20"/>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="30"/>

                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="30"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>

                                                <!--Tap-->
                                                <StackPanel Orientation="Horizontal" 
                                                    Grid.Row="0" Grid.Column="0">
                                                    <CheckBox Content="{lex:Loc TouchTap}"
                                                      IsChecked="{Binding TouchTapExists}">
                                                        <CheckBox.ToolTip>
                                                            <TextBlock Text="{lex:Loc TouchpadTapTooltip}"/>
                                                        </CheckBox.ToolTip>
                                                    </CheckBox>
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="1"
                                                    Orientation="Horizontal">
                                                    <xctk:IntegerUpDown Value="{Binding TouchTap}"
                                                                Maximum="255"
                                                                IsEnabled="{Binding TouchTapExists}">
                                                        <xctk:IntegerUpDown.ToolTip>
                                                            <TextBlock Text="{lex:Loc TouchpadTapTooltip}"/>
                                                        </xctk:IntegerUpDown.ToolTip>
                                                    </xctk:IntegerUpDown>
                                                </StackPanel>
                                                <!--Double Tap-->
                                                <StackPanel Grid.Row="1" Grid.Column="0" 
                                                    Orientation="Horizontal">
                                                    <CheckBox Content="Double Tap"
                                                  IsChecked="{Binding TouchDoubleTap}">
                                                        <CheckBox.ToolTip>
                                                            <TextBlock Text="{lex:Loc Resources:TapAndHold}"/>
                                                        </CheckBox.ToolTip>
                                                    </CheckBox>
                                                </StackPanel>

                                                <!--Lower Right RMB-->
                                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                                                    Orientation="Horizontal">
                                                    <CheckBox Content="Lower Right as RMB"
                                                      IsChecked="{Binding LowerRightTouchRMB}">
                                                        <CheckBox.ToolTip>
                                                            <TextBlock Text="{lex:Loc Resources:BestUsedRightSide}"/>
                                                        </CheckBox.ToolTip>
                                                    </CheckBox>
                                                </StackPanel>

                                                <!--Jitter-->
                                                <StackPanel Grid.Row="3" Grid.Column="0"
                                                    Orientation="Horizontal">
                                                    <CheckBox Content="Jitter compensation"
                                                  IsChecked="{Binding TouchJitter}">
                                                        <CheckBox.ToolTip>
                                                            <TextBlock Text="{lex:Loc TouchpadJitterCompTooltip}"/>
                                                        </CheckBox.ToolTip>
                                                    </CheckBox>
                                                </StackPanel>

                                                <!--Slide-->
                                                <StackPanel Orientation="Horizontal"
                                                    Grid.Row="4" Grid.Column="0">
                                                    <CheckBox Content="{lex:Loc TouchSlide}"
                                                      IsChecked="{Binding TouchSenExists}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="4" Grid.Column="1"
                                                    Orientation="Horizontal">
                                                    <xctk:IntegerUpDown Maximum="500"
                                                                Value="{Binding TouchSens}"
                                                                IsEnabled="{Binding TouchSenExists}" />
                                                    <Label Content="500 max"/>
                                                </StackPanel>

                                                <!--Scroll-->
                                                <StackPanel Orientation="Horizontal" 
                                                    Grid.Row="6" Grid.Column="0">
                                                    <CheckBox Content="{lex:Loc TouchScroll}" 
                                                      IsChecked="{Binding TouchScrollExists}">
                                                        <CheckBox.ToolTip>
                                                            <TextBlock Text="{lex:Loc TouchpadSlideTooltip}"/>
                                                        </CheckBox.ToolTip>
                                                    </CheckBox>
                                                </StackPanel>
                                                <StackPanel Grid.Row="6" Grid.Column="1"
                                                    Orientation="Horizontal">
                                                    <xctk:IntegerUpDown Value="{Binding TouchScroll}"
                                                                IsEnabled="{Binding TouchScrollExists}">
                                                        <xctk:IntegerUpDown.ToolTip>
                                                            <TextBlock Text="{lex:Loc TouchpadSlideTooltip}"/>

                                                        </xctk:IntegerUpDown.ToolTip>
                                                    </xctk:IntegerUpDown>
                                                </StackPanel>

                                                <!--Start with Slide/Scroll Off-->
                                                <StackPanel Grid.Row="7" Grid.Column="0"
                                                    Orientation="Horizontal">
                                                    <CheckBox Content="Start with Slide/Scroll Off"
                                                      IsChecked="{Binding StartTouchpadOff}">
                                                        <CheckBox.ToolTip>
                                                            <TextBlock Text="{lex:Loc Resources:TouchpadOffTip}"/>
                                                        </CheckBox.ToolTip>
                                                    </CheckBox>
                                                </StackPanel>

                                                <!--Passthru Click-->
                                                <StackPanel Grid.Row="1" Grid.Column="1"
                                                    Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding TouchpadClickPassthru}"
                                                      Content="Passthru Click Action (DS4 mode)"/>
                                                </StackPanel>

                                                <!--Rotation-->
                                                <StackPanel Grid.Row="9" Grid.Column="0"
                                                    Orientation="Horizontal">
                                                    <Label Content="Rotation"
                                               ContentStringFormat="{}{0} (Degrees)" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="9" Grid.Column="1"
                                                    Orientation="Horizontal">
                                                    <xctk:DoubleUpDown Minimum="-180" Maximum="180"
                                                           Increment="1" FormatString="F0"
                                                           Value="{Binding TouchRelMouseRotation,FallbackValue='0'}">
                                                        <xctk:DoubleUpDown.ToolTip>
                                                            <TextBlock Text="{lex:Loc TouchpadRotationTooltip}"/>
                                                        </xctk:DoubleUpDown.ToolTip>
                                                    </xctk:DoubleUpDown>
                                                    <Label Content="-180 to 180"/>
                                                </StackPanel>

                                                <!--Min Threshold-->
                                                <StackPanel Grid.Row="10" Grid.Column="0"
                                                    Orientation="Horizontal">
                                                    <Label Content="Min Threshold"
                                                   ContentStringFormat="{}{0}:" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="10" Grid.Column="1"
                                                    Orientation="Horizontal">
                                                    <xctk:DoubleUpDown Minimum="1.0" Maximum="40.0" Increment="1.0" FormatString="F1"
                                                           Value="{Binding TouchRelMouseMinThreshold,FallbackValue='1.0'}">
                                                        <xctk:DoubleUpDown.ToolTip>
                                                            <TextBlock Text="{lex:Loc TouchpadMinThresholdTooltip}"/>
                                                        </xctk:DoubleUpDown.ToolTip>
                                                    </xctk:DoubleUpDown>
                                                    <Label Content="40.0 max"/>
                                                </StackPanel>

                                                <!--Trackball-->
                                                <StackPanel  Grid.Row="12" Grid.ColumnSpan="2"
                                                     Orientation="Horizontal" >
                                                    <CheckBox Content="Trackball emulation"
                                                  IsChecked="{Binding TouchTrackball}"
                                                  VerticalAlignment="Center">
                                                        <CheckBox.ToolTip>
                                                            <TextBlock Text="{lex:Loc TouchpadTrackballEnableTooltip}"/>
                                                        </CheckBox.ToolTip>
                                                    </CheckBox>
                                                </StackPanel>
                                                <!--Friction-->
                                                <StackPanel Grid.Row="13" Grid.Column="0"
                                                    Orientation="Horizontal">
                                                    <Label Content="Trackball friction"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="13" Grid.Column="1"
                                                    Orientation="Horizontal">
                                                    <xctk:DoubleUpDown x:Name="frictionUD"
                                                               IsEnabled="{Binding TouchTrackball}"
                                                           Minimum="0.1" Maximum="20.0"
                                                               Value="{Binding TouchTrackballFriction,FallbackValue='10'}"
                                                           ValueChanged="FrictionUD_ValueChanged">
                                                        <xctk:DoubleUpDown.ToolTip>
                                                            <TextBlock Text="{lex:Loc TouchpadTrackballFrictionTooltip}"/>
                                                        </xctk:DoubleUpDown.ToolTip>
                                                    </xctk:DoubleUpDown>
                                                    <Label Content="20.0 max"/>
                                                </StackPanel>

                                                <!--Invert-->
                                                <StackPanel Grid.Row="14" Grid.Column="0"
                                                    Orientation="Horizontal">
                                                    <Label Content="Axis Invert"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="14" Grid.Column="1"
                                                    Orientation="Horizontal">
                                                    <ComboBox SelectedIndex="{Binding TouchInvertIndex}">
                                                        <ComboBoxItem Content="None" />
                                                        <ComboBoxItem Content="X" />
                                                        <ComboBoxItem Content="Y" />
                                                        <ComboBoxItem Content="X+Y" />
                                                    </ComboBox>
                                                </StackPanel>

                                                <!--Disable Invert-->
                                                <StackPanel Grid.Row="15" Grid.Column="0"
                                                    Orientation="Horizontal">
                                                    <Label Content="Disable invert trigger"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="15" Grid.Column="1"
                                                    Orientation="Horizontal">
                                                    <Button x:Name="touchDisInvertBtn" Width="170"
                                                Content="{Binding TouchDisInvertString,FallbackValue=None}"
                                                Click="TouchDisInvertBtn_Click">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Cross" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="Circle" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="Square" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="Triangle" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="L1" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="L2" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="R1" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="R2" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="Up" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="Down" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="Left" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="Right" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="L3" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="R3" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="Finger on Touchpad" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="2 Fingers on Touchpad" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="Options" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="Share" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="PS" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="Touchpad Click" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="Mute" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="Side L" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="Side R" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />

                                                                <!-- START Extra buttons for DualSense Edge controller -->
                                                                <MenuItem Header="Function Left" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="Function Right" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="Bottom Left Paddle" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <MenuItem Header="Bottom Right Paddle" IsCheckable="True" Click="TouchDisInvertMenuItem_Click" />
                                                                <!-- END Extra buttons for DualSense Edge controller -->
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                </StackPanel>

                                                <!--<local:TouchButtonUserControl x:Name="touchBtnControl1" MinWidth="400" />-->
                                            </Grid>
                                        </GroupBox>
                                    </TabItem>

                                    <!--As Control/Swipe-->
                                    <TabItem x:Name="Swipe" Header="{lex:Loc Controls}" Visibility="Collapsed">
                                        <StackPanel Orientation="Vertical">

                                            <GroupBox Header="Swipe Controls" >
                                                <Grid >
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="30"/>
                                                        <RowDefinition Height="30"/>
                                                        <RowDefinition Height="30"/>
                                                        <RowDefinition Height="30"/>

                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                                        <Button x:Name="swipeUpBtn" Content="Swipe Up" Width="155"
                                                    Tag="{Binding SwipeUp, Source={StaticResource controlIndexCheck}}"
                                                    Click="SwipeControlsButton_Click" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                                        <Label x:Name="swipeUpLb"
                                                   Content="{Binding MappingName,FallbackValue=Unassigned}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                                        <Button x:Name="swipeDownBtn" Content="Swipe Down" Width="155"
                                                    Tag="{Binding SwipeDown, Source={StaticResource controlIndexCheck}}"
                                                    Click="SwipeControlsButton_Click" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                                        <Label x:Name="swipeDownLb"
                                                   Content="{Binding MappingName,FallbackValue=Unassigned}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                                        <Button x:Name="swipeLeftBtn" Content="Swipe Left" Width="155"
                                                    Tag="{Binding SwipeLeft, Source={StaticResource controlIndexCheck}}"
                                                    Click="SwipeControlsButton_Click" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                                        <Label x:Name="swipeLeftLb" 
                                                   Content="{Binding MappingName,FallbackValue=Unassigned}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal">
                                                        <Button x:Name="swipeRightBtn" Content="Swipe Right" Width="155"
                                                    Tag="{Binding SwipeRight, Source={StaticResource controlIndexCheck}}"
                                                    Click="SwipeControlsButton_Click" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                                        <Label x:Name="swipeRightLb"
                                               Content="{Binding MappingName,FallbackValue=Unassigned}"/>
                                                    </StackPanel>



                                                    <!--<ContentControl x:Name="touchContentControl2" MinWidth="400" HorizontalAlignment="Left" Margin="5,8,0,0" />-->
                                                    <!--<local:TouchButtonUserControl x:Name="touchBtnControl2" MinWidth="400" Margin="0,8,0,0" />-->
                                                </Grid>

                                            </GroupBox>

                                            <Border Style="{DynamicResource BorderStyle}" Margin="0 4 0 0">
                                                <Grid >
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="30"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2"
                                                    Orientation="Horizontal">
                                                        <CheckBox Content="Passthru Click Action (DS4 mode)"
                                                      IsChecked="{Binding TouchpadClickPassthru}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </TabItem>

                                    <!--As Mouse/Touchpad Joystick-->
                                    <TabItem x:Name="Joystick" Header="{lex:Loc MouseJoystick}" Visibility="Collapsed">
                                        <StackPanel x:Name="touchMouseJoystickPanel"
                                            Orientation="Vertical">

                                            <GroupBox Header="Joystick Setup" Margin="0 0 0 2">
                                                <Grid >
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="30"/>
                                                        <RowDefinition Height="30"/>
                                                        <RowDefinition Height="30"/>
                                                        <RowDefinition Height="30"/>
                                                        <RowDefinition Height="30"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Row="0" Grid.Column="0"
                                                    Orientation="Horizontal">
                                                        <Label Content="Output Stick" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="0" Grid.Column="1"
                                                Orientation="Horizontal">
                                                        <ComboBox SelectedIndex="{Binding TouchMouseStickOutputStick}">
                                                            <ComboBoxItem Content="None" />
                                                            <ComboBoxItem Content="Left Stick" />
                                                            <ComboBoxItem Content="Right Stick" />
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1" Grid.Column="0"
                                                    Orientation="Horizontal">
                                                        <Label Content="Output Axes" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="1"
                                                    Orientation="Horizontal">
                                                        <ComboBox SelectedIndex="{Binding TouchMouseStickOutputAxes}"
                                                        Width="170">
                                                            <ComboBoxItem Content="None" />
                                                            <ComboBoxItem Content="Horizontal and Vertical" />
                                                            <ComboBoxItem Content="Horizontal Only" />
                                                            <ComboBoxItem Content="Vertical Only" />
                                                        </ComboBox>
                                                    </StackPanel>


                                                    <StackPanel Orientation="Horizontal"
                                                        Grid.Row="2" Grid.Column="0">
                                                        <Label Content="{lex:Loc DeadZone}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" 
                                                        Grid.Row="2" Grid.Column="1">
                                                        <xctk:IntegerUpDown Value="{Binding TouchMouseStickDeadZone}"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal"
                                                        Grid.Row="3" Grid.Column="0">
                                                        <Label Content="{lex:Loc MaxZone}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="3" Grid.Column="1"
                                                        Orientation="Horizontal">
                                                        <xctk:IntegerUpDown Value="{Binding TouchMouseStickMaxZone}"
                                                    Minimum="1" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="4" Grid.Column="0"
                                                    Orientation="Horizontal">
                                                        <Label Content="{lex:Loc OutputCurve}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="4" Grid.Column="1"
                                                    Orientation="Horizontal">
                                                        <ComboBox ItemsSource="{Binding Path=TouchMouseStickOutputCurveOptions}"
                                                DisplayMemberPath="DisplayName"
                                                SelectedValuePath="ChoiceValue"
                                                SelectedValue="{Binding TouchMouseStickOutputCurve}"/>
                                                    </StackPanel>

                                                </Grid>
                                            </GroupBox>

                                            <GroupBox Header="Axes Setup" Margin="0 2 0 2">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="30"/>
                                                        <RowDefinition Height="30"/>
                                                        <RowDefinition Height="30"/>
                                                        <RowDefinition Height="30"/>
                                                        <RowDefinition Height="30"/>
                                                        <RowDefinition Height="30"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                                        <Label Content="Minimum X" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="0" Grid.Column="1"
                                                    Orientation="Horizontal">
                                                        <xctk:DoubleUpDown Value="{Binding TouchMouseStickAntiDeadX}"
                                                        FormatString="F0" Minimum="0.0"
                                                        Maximum="100.0" Increment="10.0" />
                                                        <Label Content="%" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1" Grid.Column="0"
                                                    Orientation="Horizontal">
                                                        <Label Content="Minimum Y"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="1"
                                                    Orientation="Horizontal">
                                                        <xctk:DoubleUpDown Value="{Binding TouchMouseStickAntiDeadY}"
                                                        FormatString="F0" Minimum="0.0"
                                                        Maximum="100.0" Increment="10.0" />
                                                        <Label Content="%" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                                        <Label Content="{lex:Loc VerticalScale}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="2" Grid.Column="1"
                                                    Orientation="Horizontal">
                                                        <xctk:IntegerUpDown Value="{Binding TouchMouseStickVertScale}"
                                                                Minimum="0" Maximum="400" Increment="10" />
                                                        <Label Content="%" />
                                                    </StackPanel>


                                                    <StackPanel Grid.Row="3" Grid.Column="0"
                                                    Orientation="Horizontal">
                                                        <CheckBox Content="Invert X"
                                                      IsChecked="{Binding TouchMouseStickInvertX}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="4" Grid.Column="0"
                                                        Orientation="Horizontal">
                                                        <CheckBox Content="Invert Y"
                                                      IsChecked="{Binding TouchMouseStickInvertY}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="5" Grid.Column="0"
                                                    Orientation="Horizontal">
                                                        <Label Content="Rotation"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="5" Grid.Column="1"
                                                    Orientation="Horizontal">
                                                        <xctk:DoubleUpDown Minimum="-180"
                                                        Maximum="180" Increment="1"
                                                        FormatString="F0"
                                                        Value="{Binding TouchMouseStickRotation,FallbackValue='0'}">
                                                            <xctk:DoubleUpDown.ToolTip>
                                                                <TextBlock Text="{lex:Loc TouchpadRotationTooltip}"/>
                                                            </xctk:DoubleUpDown.ToolTip>
                                                        </xctk:DoubleUpDown>
                                                        <TextBlock Text="&#xb0;" FontSize="18"/>
                                                    </StackPanel>

                                                </Grid>
                                            </GroupBox>

                                            <GroupBox Header="Add Momentum" Margin="0 2 0 2">
                                                <Grid >
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="30"/>
                                                        <RowDefinition Height="30"/>
                                                        <RowDefinition Height="30"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Row="0" Grid.Column="0"
                                                    Orientation="Horizontal">
                                                        <CheckBox Content="Enable trackball feel"
                                                      IsChecked="{Binding TouchMouseStickTrackball}">
                                                            <CheckBox.ToolTip>
                                                                <TextBlock Text="{lex:Loc TouchpadTrackballEnableTooltip}"/>
                                                            </CheckBox.ToolTip>
                                                        </CheckBox>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                                        <Label Content="Friction"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="1"
                                                    Orientation="Horizontal">
                                                        <xctk:DoubleUpDown x:Name="touchStickFrictionUD" 
                                                        IsEnabled="{Binding TouchMouseStickTrackball}"
                                                        Minimum="0.1" Maximum="20.0"
                                                            Value="{Binding TouchMouseStickTrackballFriction,FallbackValue='10'}">
                                                            <xctk:DoubleUpDown.ToolTip>
                                                                <TextBlock Text="{lex:Loc TouchpadTrackballFrictionTooltip}"/>
                                                            </xctk:DoubleUpDown.ToolTip>
                                                        </xctk:DoubleUpDown>
                                                        <Label Content="20 max"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="2" Grid.Column="0"
                                                    Orientation="Horizontal">
                                                        <CheckBox Content="{lex:Loc MaxOutput}" ContentStringFormat="{}{0} (%)"
                                                IsChecked="{Binding TouchMouseStickMaxOutputEnabled,FallbackValue=False}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="2" Grid.Column="1"
                                                    Orientation="Horizontal">
                                                        <xctk:DoubleUpDown Value="{Binding TouchMouseStickMaxOutput}"
                                                        IsEnabled="{Binding TouchMouseStickMaxOutputEnabled,FallbackValue=False}"
                                                        FormatString="F0" Maximum="100.0"
                                                        Minimum="0.0" Increment="10.0" />
                                                        <Label Content="100 max" />
                                                    </StackPanel>

                                                </Grid>
                                            </GroupBox>

                                            <GroupBox Header="Smoothing Options" Margin="0 2 0 0">
                                                <StackPanel Orientation="Vertical">

                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox Content="Enable smoothing"
                                                          IsChecked="{Binding TouchMouseStickSmooth}"/>
                                                    </StackPanel>

                                                    <Grid x:Name="touchMouseStickOneEuroPanel" IsEnabled="{Binding TouchMouseStickSmooth, FallbackValue='False'}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="30"/>
                                                            <RowDefinition Height="30"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170"/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>


                                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                                            <Label Content="1&#x20ac; Min Cutoff" />
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                                            <xctk:DoubleUpDown FormatString="F5"
                                                                       Value="{Binding TouchMouseStickOneEuroMinCutoff,FallbackValue='1.0',UpdateSourceTrigger=LostFocus}"
                                                                       Minimum="0.00001"
                                                                       Maximum="100.0"
                                                                       Increment="0.1"/>
