                                                        IsEnabled="{Binding IdleDisconnectExists}"
                                                        Minimum="0" Maximum="60"/>
                                        <Label Content="minutes (60 max)"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.Column="0"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal">
                                        <CheckBox x:Name="useControllerReadoutCk"
                                              VerticalContentAlignment="Top"
                                              IsChecked="{Binding UseControllerReadout}"
                                              Click="UseControllerReadoutCk_Click"
                                              Width="170" Height="auto">
                                            <CheckBox.ToolTip>
                                                <TextBlock Text="{lex:Loc Resources:UseControllerForMapping}"/>
                                            </CheckBox.ToolTip>
                                            <TextBlock Text="Use Controller # for readouts"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Left" />
                                        </CheckBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.Column="1"
                                            Orientation="Horizontal"
                                            Margin="0,3,0,0"
                                            VerticalAlignment="Top"   
                                            HorizontalAlignment="Left">

                                        <xctk:IntegerUpDown x:Name="useControllerUD"
                                                        Value="0"
                                                        Minimum="0" Maximum="4"
                                                        Height="24" Width="100" MinWidth="100"
                                                        VerticalContentAlignment="Center"
                                                        IsEnabled="False"
                                                        VerticalAlignment="Top">
                                            <xctk:IntegerUpDown.ToolTip>
                                                <TextBlock Text="{lex:Loc Resources:UseControllerForMapping}"/>
                                            </xctk:IntegerUpDown.ToolTip>
                                        </xctk:IntegerUpDown>
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                        <CheckBox Content="{lex:Loc EnableOutputDataToDS4}"
                                              IsChecked="{Binding EnableOutputDataToDS4}"
                                              VerticalContentAlignment="Center">
                                            <CheckBox.ToolTip>
                                                <TextBlock Text="{lex:Loc EnableOutputDataToDS4Tip}"/>
                                            </CheckBox.ToolTip>
                                        </CheckBox>
                                    </StackPanel>

                                </Grid>

                            </GroupBox>

                            <GroupBox Header="{lex:Loc Rumble}"  Margin="0 3">

                                <Grid >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Grid.Row="0" Grid.Column="0">
                                        <Label Content="Test controller's vibrations"/>
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center" 
                                            Grid.Row="1" Grid.Column="0">
                                        <Label Content="Vibration strength"/>
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center" 
                                            Grid.Row="2" Grid.Column="0">
                                        <Label Content="Duration (0 = Default)"/>
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center" 
                                            Grid.Row="0" Grid.Column="1"
                                            Orientation="Horizontal">
                                        <Button x:Name="heavyRumbleTestBtn"
                                            Margin="0,0,3,0"
                                            Content="{lex:Loc TestHeavy}" 
                                            Click="RumbleTestBtn_Click" />

                                        <Button x:Name="lightRumbleTestBtn"
                                            Margin="3,0,0,0"
                                            Content="{lex:Loc TestLight}" 
                                            Click="RumbleTestBtn_Click" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                        <xctk:IntegerUpDown x:Name="RumbleBoostIUD"
                                                        Value="{Binding RumbleBoost}"
                                                        Minimum="0" Maximum="200"
                                                        Increment="10"/>
                                        <Label Content="% (200 max)"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                        <xctk:IntegerUpDown x:Name="RumbleAutostopTimeIUD"
                                                        Value="{Binding RumbleAutostopTime}"
                                                        Minimum="0" Maximum="3600" Increment="1">
                                            <xctk:IntegerUpDown.ToolTip>
                                                <TextBlock Text="{lex:Loc RumbleMaxSecsTip}"/>
                                            </xctk:IntegerUpDown.ToolTip>
                                        </xctk:IntegerUpDown>
                                        <Label Content="{lex:Loc RumbleMaxSecs}"
                                           ContentStringFormat="{}{0} (3600 max)"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.Column="1"
                                            VerticalAlignment="Center">
                                        <CheckBox Content="{lex:Loc InverseMotors}"
                                              IsChecked="{Binding InverseRumbleMotors}" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Margin="0 3"
                                  Header="{lex:Loc DualSRumbleSpecificSettings}">
                                <Grid >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Grid.Row="0" VerticalAlignment="Center">
                                        <Label Content="Rumble mode"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal">
                                        <ComboBox x:Name="dualSRumbleEmuMode"
                                              SelectedIndex="{Binding DualSenseRumbleEmulationPerIndex, FallbackValue=0}">
                                            <ComboBox.ToolTip>
                                                <TextBlock Text="{lex:Loc DualSRumbleModes_Tip}"/>
                                            </ComboBox.ToolTip>
                                            <ComboBoxItem Content="{lex:Loc DualSRumbleModeAccurate}"   />
                                            <ComboBoxItem Content="{lex:Loc DualSRumbleModeLegacy}" />
                                            <ComboBoxItem Content="{lex:Loc DualSRumbleModeDisabled}" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
                                        <Label Content="Rumble strenght" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1"
                                            VerticalAlignment="Center" Orientation="Horizontal">
                                        <ComboBox SelectedIndex="{Binding DualSenseHapticPowerLevelPerIndex, FallbackValue=0}">
                                            <ComboBox.ToolTip>
                                                <TextBlock Text="{lex:Loc DualSRumblePowerLevel_Tip}"/>
                                            </ComboBox.ToolTip>
                                            <ComboBoxItem Content="100%" />
                                            <ComboBoxItem Content="87%" />
                                            <ComboBoxItem Content="75%" />
                                            <ComboBoxItem Content="62%" />
                                            <ComboBoxItem Content="50%" />
                                            <ComboBoxItem Content="37%" />
                                            <ComboBoxItem Content="25%" />
                                            <ComboBoxItem Content="12%" />
                                        </ComboBox>

                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                                            VerticalAlignment="Center">
                                        <CheckBox x:Name="dualSForceGenRumbleRescale"
                                                  Width="300"
                                                  Height="Auto"
                                              IsChecked="{Binding EnableGenericRumbleStrRescaleForDualSenseDevices}">
                                            <CheckBox.ToolTip>
                                                <TextBlock Text="{lex:Loc DualSRumbleForceGenericRescale_Tip}"/>
                                            </CheckBox.ToolTip>
                                            <TextBlock Text="{lex:Loc DualSRumbleForceGenericRescale}" TextWrapping="Wrap"/>
                                        </CheckBox>
                                    </StackPanel>

                                </Grid>

                            </GroupBox>


                            <GroupBox Header="Profile" Margin="0 3">
                                <StackPanel Orientation="Horizontal">


                                    <StackPanel Orientation="Horizontal"
                                            Grid.Column="0">
                                        <CheckBox x:Name="launchProgCk"
                                              Content="{lex:Loc LaunchProgramWithProfile}"
                                              IsChecked="{Binding LaunchProgramExists}"
                                              IsEnabled="{Binding LaunchProgramExists}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="8 0">
                                        <Button x:Name="launchProgBrowseBtn"
                                            Click="LaunchProgBrowseBtn_Click">
                                            <Button.Content>
                                                <PriorityBinding>
                                                    <Binding Path="LaunchProgramName" />
                                                    <lex:BLoc Key="Browse" />
                                                </PriorityBinding>
                                            </Button.Content>
                                        </Button>
                                        <Button x:Name="launchProgIconBtn"
                                            Margin="8,0,0,0"
                                            Focusable="False"
                                            Width="24"
                                            VerticalContentAlignment="Center">
                                            <Button.Background>
                                                <ImageBrush ImageSource="{Binding LaunchProgramIcon}" />
                                            </Button.Background>
                                        </Button>
                                    </StackPanel>

                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Mouse emulation" Margin="0 3" >
                                <Grid >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>


                                    <StackPanel Grid.Row="0" Grid.Column="0"
                                            Orientation="Horizontal" Height="25">
                                        <Label Content="{lex:Loc MouseSensitivity}"
                                           VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1"
                                            Orientation="Horizontal" >
                                        <xctk:IntegerUpDown Value="{Binding ButtonMouseSensitivity,FallbackValue=25}"
                                                        Minimum="0" Maximum="255"
                                                        Increment="1"
                                                        VerticalContentAlignment="Center"/>
                                        <Label Content="{Binding OutputMouseSpeed,Mode=OneWay}"
                                           ContentStringFormat="{}{0} pps"
                                           MinWidth="70"
                                           Margin="5,0,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0"
                                            Orientation="Horizontal">
                                        <Label Content="{lex:Loc MouseVerticalScale}"
                                           ContentStringFormat="{}{0} (%)"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1"
                                            Orientation="Horizontal" >
                                        <xctk:IntegerUpDown Value="{Binding ButtonMouseVerticalScale,FallbackValue='100'}"
                                                        Minimum="0" Maximum="500"
                                                        Increment="10"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0"
                                            Orientation="Horizontal" >
                                        <Label Content="{lex:Loc MouseOffset}"
                                           ContentStringFormat="{}{0} (%)"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                        <xctk:DoubleUpDown FormatString="F3"
                                                       DefaultValue="0"
                                                       Minimum="0" Maximum="100"
                                                       Value="{Binding ButtonMouseOffset,FallbackValue=0,UpdateSourceTrigger=PropertyChanged}" />
                                        <Label Content="{Binding MouseOffsetSpeed,Mode=OneWay}"
                                           ContentStringFormat="{}{0:0.00} pps"
                                           MinWidth="70" Margin="5,0,0,0"
                                           VerticalContentAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.Column="0"
                                            Orientation="Horizontal" 
                                            VerticalAlignment="Center">
                                        <CheckBox Content="{lex:Loc MouseAcceleration}"
                                                  IsChecked="{Binding MouseAcceleration}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" 
                                            VerticalAlignment="Center">
                                        <CheckBox Content="{lex:Loc EnableTouchpadToggle}"
                                                  IsChecked="{Binding EnableTouchpadToggle}">
                                            <CheckBox.ToolTip>
                                                <TextBlock Text="{lex:Loc Resources:EnableTouchToggle}"/>
                                            </CheckBox.ToolTip>
                                        </CheckBox>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="{lex:Loc AbsoluteMouseOptions}" Margin="0 3">

                                <StackPanel Orientation="Vertical">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0"
                                                VerticalAlignment="Center">

                                            <Label Content="{lex:Loc Width}"
                                                ContentStringFormat="{}{0}"
                                                VerticalContentAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                            <xctk:DoubleUpDown FormatString="F2"
                                                            Value="{Binding AbsWidth}"
                                                            Minimum="0.0" Maximum="1.0"
                                                            Increment="0.05"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0"
                                                VerticalAlignment="Center">
                                            <Label Content="{lex:Loc Height}"
                                                ContentStringFormat="{}{0}"/>

                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                            <xctk:DoubleUpDown FormatString="F2"
                                                            Value="{Binding AbsHeight}"
                                                            Minimum="0.0" Maximum="1.0"
                                                            Increment="0.05"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0"
                                                VerticalAlignment="Center">
                                            <Label Content="{lex:Loc XCenter}"
                                               ContentStringFormat="{}{0}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                            <xctk:DoubleUpDown FormatString="F2" Value="{Binding AbsXCenter}"
                                                           Minimum="0.0" Maximum="1.0"
                                                           Increment="0.05"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3" Grid.Column="0"
                                                VerticalAlignment="Center">
                                            <Label Content="{lex:Loc YCenter}"
                                                ContentStringFormat="{}{0}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3" Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                            <xctk:DoubleUpDown FormatString="F2" Value="{Binding AbsYCenter}"
                                                           Minimum="0.0" Maximum="1.0"
                                                           Increment="0.05"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="4" Grid.Column="0"
                                                VerticalAlignment="Center">
                                            <Label Content="{lex:Loc AntiRadius}"
                                                ContentStringFormat="{}{0} (%)"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="4" Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                            <xctk:DoubleUpDown FormatString="F2" Value="{Binding AbsAntiRadius}"
                                                           Minimum="0.0" Maximum="1.0"
                                                           Increment="0.05"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="5" Grid.Column="0"
                                                VerticalAlignment="Center">
                                            <CheckBox Content="{lex:Loc SnapToCenter}"
                                                IsChecked="{Binding AbsSnapCenter}"/>
                                        </StackPanel>
                                    </Grid>

                                </StackPanel>
                            </GroupBox>

                        </StackPanel>

                    </ScrollViewer>

                </TabItem>

            </TabControl>
        </DockPanel>

    </DockPanel>
</UserControl>
