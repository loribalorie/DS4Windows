                                                Content="{Binding MappingName,FallbackValue=Unassigned}"
                                                HorizontalAlignment="Center"/>


                                            <Label Content="{lex:Loc HipFireDelay}" ContentStringFormat="{}{0}" Grid.Row="3" Grid.Column="0" />

                                            <StackPanel Grid.Row="3" Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center">

                                                <xctk:IntegerUpDown Value="{Binding L2HipFireTime}"
                                                                Maximum="5000" Minimum="0" Increment="10">
                                                    <xctk:IntegerUpDown.ToolTip>
                                                        <TextBlock >
                                                    Time delay used with Two State Modes <Bold>Hire Fire</Bold> and <Bold>Hip Fire Exclusive</Bold>. The time delay before an action is first executed.
                                                        </TextBlock>
                                                    </xctk:IntegerUpDown.ToolTip>
                                                </xctk:IntegerUpDown>
                                                <Label Content="ms"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal"
                                                    HorizontalAlignment="Center">

                                                <xctk:IntegerUpDown   Value="{Binding R2HipFireTime}"
                                                                Maximum="5000"
                                                                Minimum="0" Increment="10">
                                                    <xctk:IntegerUpDown.ToolTip>
                                                        <TextBlock TextWrapping="Wrap">
                                                    Time delay used with Two State Modes <Bold>Hire Fire</Bold> and <Bold>Hip Fire Exclusive</Bold>. The time delay before an action is first executed.
                                                        </TextBlock>
                                                    </xctk:IntegerUpDown.ToolTip>
                                                </xctk:IntegerUpDown>
                                                <Label Content="ms"/>
                                            </StackPanel>

                                            <Label Content="{lex:Loc TriggerEffect}" ContentStringFormat="{}{0}:" Grid.Row="4" Grid.Column="0" />

                                            <ComboBox Grid.Row="4" Grid.Column="1"
                                                ItemsSource="{Binding Path=TriggerEffectChoices}"
