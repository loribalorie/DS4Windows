<Window x:Class="DS4WinWPF.DS4Forms.SaveWhere"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
        lex:LocalizeDictionary.DesignCulture=""
        lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        mc:Ignorable="d"
        Title="{lex:Loc SaveWhere.WinTitle}"
        Height="300"
        Width="550"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="{DynamicResource BackgroundColor}">
    
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">

        <Border x:Name="multipleSavesDockP" d:Visibility="Visible" Margin="0 0 0 10"
                Style="{DynamicResource BorderStyle}" Background="{DynamicResource AccentColor}">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <TextBlock Text="{lex:Loc SaveWhere.MultipleSaves}" Foreground="{DynamicResource AccentForeColor}" FontWeight="Medium" FontSize="15"/>
                <CheckBox x:Name="dontDeleteCk" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{lex:Loc SaveWhere.DontDelete}" Foreground="{DynamicResource AccentForeColor}"/>
                </CheckBox>
            </StackPanel>
        </Border>

        <StackPanel>
            <TextBlock x:Name="pickWhereTxt" Text="{lex:Loc SaveWhere.PickWhere}" Foreground="{DynamicResource ForegroundColor}"
                   TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                       FontWeight="Medium" FontSize="15"/> 
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Margin="0 10 0 0">

            <Border Style="{DynamicResource BorderStyle}" Margin="0 0 4 0" Width="250" Height="150">
                <StackPanel x:Name="progFolderPanel">
                    <Button x:Name="progFolderBtn" Content="{lex:Loc ProgramFolder}" Click="ProgFolderBtn_Click"
                            Height="30" Width="130" Margin="0 15 0 0"/>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Text="{lex:Loc SaveWhere.ProgramFolderDescText}"
                               Margin="8" Foreground="{DynamicResource ForegroundColor}" Opacity="0.8"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource BorderStyle}" Margin="4 0 0 0" Width="250" Height="150">
                <StackPanel DockPanel.Dock="Right" Margin="0 15 0 0">
                    <Button x:Name="appdataBtn" Content="{lex:Loc Appdata}" Click="AppdataBtn_Click"
                            Height="30" Width="130"/>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource ForegroundColor}"
                               Text="{lex:Loc SaveWhere.AppDataDescText}" Opacity="0.8"
                               Margin="8"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</Window>
