<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
    x:Class="DS4WinWPF.DS4Forms.PresetOptionWindow"
    lex:LocalizeDictionary.DesignCulture=""
    lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
    lex:ResxLocalizationProvider.DefaultDictionary="Strings"
    mc:Ignorable="d"
    Title="Select Preset"
    Height="250"
    Width="500"
    Padding="0"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    Style="{DynamicResource WindowStyle}"
    Closed="Window_Closed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <DockPanel>
        <TabControl x:Name="screensTabControl" Margin="0,3,0,0"
                    Style="{DynamicResource HiddenTabControlStyle}">
            
            <TabItem x:Name="IntroTab" Header="{lex:Loc Intro}">
                <DockPanel >
                    <StackPanel Orientation="Horizontal"
                                Margin="10"
                                DockPanel.Dock="Bottom" HorizontalAlignment="Right">
                        <Button x:Name="noPresetBtn" Content="No" MinWidth="60" Margin="0,0,10,0" TabIndex="0" Click="NoPresetBtn_Click" />
                        <Button x:Name="yesPresetBtn" Content="Yes" MinWidth="60" TabIndex="1" Click="YesPresetBtn_Click" />
                    </StackPanel>
                    <StackPanel Margin="15,20,15,0">
                        <TextBlock Text="{lex:Loc PresetIntrotext}" TextWrapping="Wrap"
                                   Foreground="{StaticResource ForegroundColor}"/>
                    </StackPanel>
                </DockPanel>
            </TabItem>
            
            <TabItem x:Name="PresetListTab" Header="{lex:Loc PresetOptWin.PresetMenu}">
                <DockPanel LastChildFill="False" Margin="0,10,0,0">

                    <StackPanel Orientation="Vertical" DockPanel.Dock="Top" HorizontalAlignment="Left"
                                Margin="10,10,10,0">
                        <DockPanel LastChildFill="False" MinHeight="30" Width="400">
                            <Label Content="{lex:Loc Presets}" />
                            <ComboBox x:Name="presetComboBox"
                                      DockPanel.Dock="Right"
                                      ItemsSource="{Binding PresetsList, Mode=OneTime}"
                                  SelectedIndex="{Binding PresetIndex, FallbackValue=0}"
                                  MinWidth="250">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                        <DockPanel x:Name="outputContStackPanel" LastChildFill="False"
                                   MinHeight="30"
                                    Visibility="{Binding PresetDisplayOutputCont, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <Label Content="{lex:Loc PresetOptWin.OutputController}" ContentStringFormat="{}{0}" />
                            <ComboBox ItemsSource="{Binding OutputChoices}"
                                      DockPanel.Dock="Right"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="ChoiceValue"
                                  Width="250"
                                  SelectedValue="{Binding ControllerChoice}"/>
                        </DockPanel>

                    </StackPanel>

                    
                    <StackPanel Orientation="Vertical" VerticalAlignment="Bottom"
                                Margin="10,0"
                                DockPanel.Dock="Top">
                        <Label Content="{lex:Loc Description}"/>
                        <TextBlock Text="{Binding PresetDescription, Mode=OneWay}"
                                   Margin="6"
                                   Foreground="{DynamicResource ForegroundColor}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Bottom" Margin="10">
                        
                        <Button x:Name="presetCancelBtn" Content="{lex:Loc Cancel}" MinWidth="60" Click="PresetCancelBtn_Click" />
                        <Button x:Name="presetApplyBtn" Content="{lex:Loc Apply}" MinWidth="60" Margin="10,0,0,0" Click="PresetApplyBtn_Click" />
                    </StackPanel>
                </DockPanel>

            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
