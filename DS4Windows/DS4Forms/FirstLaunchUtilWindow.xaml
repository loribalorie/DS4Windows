<Window x:Class="DS4WinWPF.DS4Forms.FirstLaunchUtilWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture=""
        lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        mc:Ignorable="d"
        Title="{lex:Loc FirstLaunch.WinTitle}"
        Height="Auto" Width="800"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource WindowStyle}"
        UseLayoutRounding="True">
    
    <!-- Window will likely be used for other first launch configuration in the future.
         For now, only deal with device mapper support -->
    <DockPanel Margin="8">
        <Button Content="Continue" Click="Button_Click" DockPanel.Dock="Bottom"/>

        <TabControl Name="pagesTabControl" TabStripPlacement="Left"
                    Style="{DynamicResource HiddenTabControlStyle}">
            <TabItem Header="{lex:Loc FirstLaunch.DeviceSupport}"
                     Visibility="Collapsed">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{lex:Loc FirstLaunch.Header}" FontWeight="Medium" FontSize="20" HorizontalAlignment="Center"
                               Margin="0,8,0,0" DockPanel.Dock="Top" />

                    
                        <ScrollViewer VerticalScrollBarVisibility="Auto" >
                            <StackPanel Orientation="Vertical" Margin="8">
                            
                            <Border Style="{DynamicResource BorderStyle}" Margin="8 8 8 0">
                                <TextBlock TextWrapping="Wrap" FontSize="14"
                                       DockPanel.Dock="Top" Margin="8 0">
                                    <TextBlock.Text>
                                        <lex:Loc Key="FirstLaunch.DeviceIntroText"></lex:Loc>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>

                            <Border Style="{DynamicResource BorderStyle}" Margin="8 8 8 0">
                                    <StackPanel Orientation="Vertical">
                                        <CheckBox Name="ds4SupportEnableCkb" IsChecked="{Binding EnableDS4}" Content="{lex:Loc FirstLaunch.DS4EnableCkbLabel}" FontWeight="Bold" />
                                        <TextBlock Text="{lex:Loc FirstLaunch.DS4EnableText}" Margin="50,0,0,0" />
                                    </StackPanel>
                                </Border>

                            <Border Style="{DynamicResource BorderStyle}" Margin="8 8 8 0">
                                    <StackPanel Orientation="Vertical">
                                        <CheckBox Name="dualSenseSupportEnableCkb" IsChecked="{Binding EnableDualSense}" Content="{lex:Loc FirstLaunch.DSEnableCkbLabel}" FontWeight="Bold" />
                                        <TextBlock Text="{lex:Loc FirstLaunch.DSEnableText}" Margin="50,0,0,0" />
                                    </StackPanel>
                                </Border>

                            <Border Style="{DynamicResource BorderStyle}" Margin="8 8 8 0">
                                    <StackPanel Orientation="Vertical">
                                        <CheckBox Name="switchProSupportEnableCkb" IsChecked="{Binding EnableSwitchPro}" Content="{lex:Loc FirstLaunch.SwitchProEnableCkbLabel}" FontWeight="Bold" />
                                        <TextBlock Text="{lex:Loc FirstLaunch.SwitchProEnableText}" Margin="50,0,0,0" />
                                    </StackPanel>
                                </Border>

                            <Border Style="{DynamicResource BorderStyle}" Margin="8 8 8 0">
                                    <StackPanel Orientation="Vertical">
                                        <CheckBox Name="joyConSupportEnableCkb" IsChecked="{Binding EnableJoyCon}" Content="{lex:Loc FirstLaunch.JoyConEnableCkbLabel}" FontWeight="Bold" />
                                        <TextBlock Text="{lex:Loc FirstLaunch.JoyConEnableText}" Margin="50,0,0,0" />
                                    </StackPanel>
                                </Border>

                            <Border Style="{DynamicResource BorderStyle}" Margin="8 8 8 0">
                                    <StackPanel Orientation="Vertical">
                                        <CheckBox Name="ds3SupportEnableCkb" IsChecked="{Binding EnableDS3}" Content="{lex:Loc FirstLaunch.DS3EnableCkbLabel}" FontWeight="Bold" />
                                        <TextBlock Text="{lex:Loc FirstLaunch.DS3EnableText}" Margin="50,0,0,0" />
                                        <TextBlock Margin="50 0 0 0">
                                        <Hyperlink x:Name="dsHidMiniLink" Click="DsHidMiniLink_Click" Foreground="{DynamicResource AccentColor}">
                                            https://vigem.org/projects/DsHidMini/
                                        </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    
                </StackPanel>
                
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
