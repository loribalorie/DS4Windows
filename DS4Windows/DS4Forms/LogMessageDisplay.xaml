<Window x:Class="DS4WinWPF.DS4Forms.LogMessageDisplay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
        lex:LocalizeDictionary.DesignCulture=""
        lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        mc:Ignorable="d"
        UseLayoutRounding="True"
        Title="Log" MinHeight="200" Height="200" Width="600" MinWidth="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource WindowStyle}">
    
    <DockPanel Margin="8" LastChildFill="True">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0 8 0 0">
            <Button x:Name="okayButton" Content="OK" Click="OkayButton_Click" />
        </StackPanel>
        <Border Style="{DynamicResource BorderStyle}" DockPanel.Dock="Top">
            <RichTextBox x:Name="richMessageBox" VerticalScrollBarVisibility="Auto"
                     IsReadOnly="True" IsDocumentEnabled="True"
                     BorderBrush="{x:Null}" BorderThickness="0"
                     HorizontalContentAlignment="Stretch"/>
        </Border>
    </DockPanel>
</Window>
