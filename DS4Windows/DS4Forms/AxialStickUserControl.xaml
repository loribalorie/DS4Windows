<UserControl x:Class="DS4WinWPF.DS4Forms.AxialStickUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:LocalizeDictionary.DesignCulture=""
             lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="400">

    <UserControl.Resources>
        <xctk:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <local:ControlIndexCheck x:Key="controlIndexCheck" />
        <local:ResourcePaths x:Key="resourcesPaths" />
    </UserControl.Resources>

    <Grid x:Name="mainGrid" Background="{DynamicResource BackgroundColor}">
        <!--<Grid.Resources>
            <Style BasedOn="{StaticResource DoubleUpDown}" TargetType="{x:Type xctk:DoubleUpDown}">
            
            </Style>

        </Grid.Resources>-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="165"/>
            <ColumnDefinition Width="76"/>
            <ColumnDefinition Width="76"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Label Content="X-Axis" Grid.Column="1"
               HorizontalAlignment="Center"/>
        <Label Content="Y-Axis" Grid.Column="2"
               HorizontalAlignment="Center"/>

        <Label Content="{lex:Loc DeadZone}"
               ContentStringFormat="{}{0}"
               Grid.Row="1" Grid.Column="0" />
        <xctk:DoubleUpDown Value="{Binding DeadZoneX,UpdateSourceTrigger=LostFocus}"
                   FormatString="F2" 
                   Grid.Row="1" Grid.Column="1" 
                   Maximum="1.0"
                   Minimum="0.0" Increment="0.1"
                   Width="70" HorizontalAlignment="Left"/>
        <xctk:DoubleUpDown Value="{Binding DeadZoneY,UpdateSourceTrigger=LostFocus}"
                   FormatString="F2" 
                   Grid.Row="1" Grid.Column="2"
                   Maximum="1.0"
                   Minimum="0.0" Increment="0.1"
                   Width="70" HorizontalAlignment="Left"/>

        <Label Content="{lex:Loc MaxZone}"
               ContentStringFormat="{}{0}"
               Grid.Row="2" Grid.Column="0" />
        <xctk:DoubleUpDown Value="{Binding MaxZoneX}" FormatString="F2" 
                   Grid.Row="2" Grid.Column="1"
                   Maximum="1.0" Minimum="0.0" Increment="0.1"
                   Width="70" HorizontalAlignment="Left"/>
        <xctk:DoubleUpDown Value="{Binding MaxZoneY}" FormatString="F2"
                   Grid.Row="2" Grid.Column="2"
                   Maximum="1.0" Minimum="0.0" Increment="0.1"
                   Width="70" HorizontalAlignment="Left"/>

        <Label Content="{lex:Loc AntiDeadZone}"
               ContentStringFormat="{}{0}"
               Grid.Row="3" Grid.Column="0" />
        <xctk:DoubleUpDown Value="{Binding AntiDeadZoneX}" FormatString="F2" 
                   Grid.Row="3" Grid.Column="1"
                   Maximum="1.0" Minimum="0.0" Increment="0.1"
                   Width="70" HorizontalAlignment="Left"/>
        <xctk:DoubleUpDown Value="{Binding AntiDeadZoneY}" FormatString="F2" 
                   Grid.Row="3" Grid.Column="2"
                   Maximum="1.0" Minimum="0.0" Increment="0.1"
                   Width="70" HorizontalAlignment="Left"/>

        <Label Content="{lex:Loc MaxOutput}"
               ContentStringFormat="{}{0}"
               Grid.Row="4" Grid.Column="0" />
        <xctk:DoubleUpDown Value="{Binding MaxOutputX}" FormatString="F2"
                   Grid.Row="4" Grid.Column="1"
                   Maximum="1.0" Minimum="0.0" Increment="0.1"
                   Width="70" HorizontalAlignment="Left"/>
        <xctk:DoubleUpDown Value="{Binding MaxOutputY}" FormatString="F2" 
                   Grid.Row="4" Grid.Column="2"
                   Maximum="1.0" Minimum="0.0" Increment="0.1"
                   Width="70" HorizontalAlignment="Left"/>

        <!--<TextBlock Text="X" Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
        <TextBlock Text="Y" Grid.Column="2"  FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />


        
        <Label Content="{lex:Loc DeadZone}"
               ContentStringFormat="{}{0}:"
               Grid.Row="1" Grid.Column="0" />
        
        <xctk:DoubleUpDown Value="{Binding DeadZoneX,UpdateSourceTrigger=LostFocus}"
                           FormatString="F2" MinWidth="50"
                           Grid.Row="1" Grid.Column="1"
                           Maximum="1.0" Minimum="0.0" Increment="0.1"
                           Margin="{StaticResource spaceMargin}" />
        
        <xctk:DoubleUpDown Value="{Binding DeadZoneY,UpdateSourceTrigger=LostFocus}"
                           FormatString="F2" MinWidth="50"
                           Grid.Row="1" Grid.Column="2"
                           Maximum="1.0" Minimum="0.0" Increment="0.1"
                           Margin="{StaticResource spaceMargin}" />

        <Label Content="{lex:Loc MaxZone}" ContentStringFormat="{}{0}:" Grid.Row="2" Grid.Column="0" />
        <xctk:DoubleUpDown   Value="{Binding MaxZoneX}" FormatString="F2" MinWidth="50" Grid.Row="2" Grid.Column="1" Maximum="1.0" Minimum="0.0" Increment="0.1"
                                                   Margin="{StaticResource spaceMargin}" />
        <xctk:DoubleUpDown   Value="{Binding MaxZoneY}" FormatString="F2" MinWidth="50" Grid.Row="2" Grid.Column="2" Maximum="1.0" Minimum="0.0" Increment="0.1"
                                                   Margin="{StaticResource spaceMargin}" />

        <Label Content="{lex:Loc AntiDeadZone}" ContentStringFormat="{}{0}:" Grid.Row="3" Grid.Column="0" />
        <xctk:DoubleUpDown   Value="{Binding AntiDeadZoneX}" FormatString="F2" MinWidth="50" Grid.Row="3" Grid.Column="1" Maximum="1.0" Minimum="0.0" Increment="0.1"
                                                   Margin="{StaticResource spaceMargin}" />
        <xctk:DoubleUpDown   Value="{Binding AntiDeadZoneY}" FormatString="F2" MinWidth="50" Grid.Row="3" Grid.Column="2" Maximum="1.0" Minimum="0.0" Increment="0.1"
                                                   Margin="{StaticResource spaceMargin}" />

        <Label Content="{lex:Loc MaxOutput}" ContentStringFormat="{}{0}:" Grid.Row="4" Grid.Column="0" />
        <xctk:DoubleUpDown   Value="{Binding MaxOutputX}" FormatString="F2" MinWidth="50" Grid.Row="4" Grid.Column="1" Maximum="1.0" Minimum="0.0" Increment="0.1"
                                                   Margin="{StaticResource spaceMargin}" />
        <xctk:DoubleUpDown   Value="{Binding MaxOutputY}" FormatString="F2" MinWidth="50" Grid.Row="4" Grid.Column="2" Maximum="1.0" Minimum="0.0" Increment="0.1"
                                                   Margin="{StaticResource spaceMargin}" />-->
    </Grid>
</UserControl>
