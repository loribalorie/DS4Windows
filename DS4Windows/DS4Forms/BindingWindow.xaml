                                            </Grid.Resources>

                                            <Button x:Name="uarrowBtn" Content="↑" Grid.Row="0" Grid.Column="1" 
                                                Style="{StaticResource btnDpad}" />
                                            <Button x:Name="larrowBtn" Content="←" Grid.Row="1" Grid.Column="0"
                                                Style="{StaticResource btnDpad}"/>
                                            <Button x:Name="darrowBtn" Content="↓" Grid.Row="1" Grid.Column="1"
                                                Style="{StaticResource btnDpad}"/>
                                            <Button x:Name="rarrowBtn" Content="→" Grid.Row="1" Grid.Column="2"
                                                Style="{StaticResource btnDpad}"/>
                                        </Grid>
                                    </DockPanel>

                                    <Grid Margin="0" Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
