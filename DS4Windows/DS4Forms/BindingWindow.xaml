                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="capsLBtn" Content="Caps" Grid.Column="0"/>
                                        <Button x:Name="aKeyBtn" Content="A" Grid.Column="1"/>
                                        <Button x:Name="sBtn" Content="S" Grid.Column="2"/>
                                        <Button x:Name="dBtn" Content="D" Grid.Column="3"/>
                                        <Button x:Name="fBtn" Content="F" Grid.Column="4"/>
                                        <Button x:Name="gBtn" Content="G" Grid.Column="5"/>
                                        <Button x:Name="hBtn" Content="H" Grid.Column="6"/>
                                        <Button x:Name="jBtn" Content="J" Grid.Column="7"/>
                                        <Button x:Name="kBtn" Content="K" Grid.Column="8"/>
                                        <Button x:Name="lBtn" Content="L" Grid.Column="9"/>
                                        <Button x:Name="semicolonBtn" Content=";" Grid.Column="10"/>
                                        <Button x:Name="aposBtn" Content="'" Grid.Column="11"/>
                                        <Button x:Name="enterBtn" Content="Enter" Grid.Column="12"/>
                                    </Grid>

                                    <Grid >
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="2.5*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="lshiftBtn" Content="LShift" Grid.Column="0"/>
                                        <Button x:Name="zBtn" Content="Z" Grid.Column="1"/>
                                        <Button x:Name="xKeyBtn" Content="X" Grid.Column="2"/>
                                        <Button x:Name="cBtn" Content="C" Grid.Column="3"/>
                                        <Button x:Name="vBtn" Content="V" Grid.Column="4"/>
                                        <Button x:Name="bKeyBtn" Content="B" Grid.Column="5"/>
                                        <Button x:Name="nBtn" Content="N" Grid.Column="6"/>
                                        <Button x:Name="mBtn" Content="M" Grid.Column="7"/>
                                        <Button x:Name="commaBtn" Content="," Grid.Column="8"/>
                                        <Button x:Name="periodBtn" Content="." Grid.Column="9"/>
                                        <Button x:Name="bslashBtn" Content="/" Grid.Column="10"/>
                                        <Button x:Name="rshiftBtn" Content="RShift" Grid.Column="11"/>
                                    </Grid>

                                    <Grid >
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="5.2*"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="lctrlBtn" Content="LCtrl" Grid.Column="0"/>
                                        <Button x:Name="lWinBtn" Content="LWin" Grid.Column="1"/>
                                        <Button x:Name="laltBtn" Content="LAlt" Grid.Column="2"/>
                                        <Button x:Name="spaceBtn" Content="Space" Grid.Column="3"/>
                                        <Button x:Name="raltBtn" Content="RAlt" Grid.Column="4"/>
                                        <Button x:Name="rwinBtn" Content="RWin" Grid.Column="5"/>
                                        <Button x:Name="rctrlBtn" Content="RCtrl" Grid.Column="6"/>
                                    </Grid>
                                </UniformGrid>

                                <Grid x:Name="otherKeysMouseGrid" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.5*" />
                                        <ColumnDefinition Width="0.7*"/>
                                        <ColumnDefinition x:Name="mouseGridColumn" Width="0.6*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Margin="2 0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="prtBtn" Content="PrtSc" Grid.Row="0" Grid.Column="0"/>
                                        <Button x:Name="sclBtn" Content="ScLk"  Grid.Row="0" Grid.Column="1"/>
                                        <Button x:Name="brkBtn" Content="Brk" Grid.Row="0" Grid.Column="2"/>

                                        <Button x:Name="insBtn" Content="Ins" Grid.Row="1" Grid.Column="0"/>
                                        <Button x:Name="homeBtn" Content="Home" Grid.Row="1" Grid.Column="1"/>
                                        <Button x:Name="pgupBtn" Content="PgUp" Grid.Row="1" Grid.Column="2"/>

                                        <Button x:Name="delBtn" Content="Del" Grid.Row="2" Grid.Column="0"/>
                                        <Button x:Name="endBtn" Content="End" Grid.Row="2" Grid.Column="1"/>
                                        <Button x:Name="pgdwBtn" Content="PgDn" Grid.Row="2" Grid.Column="2"/>

                                        <Button x:Name="uarrowBtn" Content="↑" Grid.Row="4" Grid.Column="1"/>

                                        <Button x:Name="larrowBtn" Content="←" Grid.Row="5" Grid.Column="0"/>
                                        <Button x:Name="darrowBtn" Content="↓" Grid.Row="5" Grid.Column="1"/>
                                        <Button x:Name="rarrowBtn" Content="→" Grid.Row="5" Grid.Column="2"/>
                                    </Grid>

                                    <Grid Grid.Column="1" Margin="2 0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="prevTrackBtn" Content="9" FontFamily="Webdings" />
                                        <Button x:Name="stopBtn" Content="&lt;" FontFamily="Webdings" Grid.Column="1" />
                                        <Button x:Name="playBtn" Content="4" FontFamily="Webdings" Grid.Column="2" />
                                        <Button x:Name="nextTrackBtn" Content=":" FontFamily="Webdings" Grid.Column="3" />
                                        <Button x:Name="volupBtn" Content="Vol ↑" Grid.Column="4" FontSize="10" />

                                        <Button x:Name="numlockBtn" Content="NLk" Grid.Row="1" Grid.Column="0" FontSize="9"/>
                                        <Button x:Name="numdivideBtn" Content="/" Grid.Row="1" Grid.Column="1" />
                                        <Button x:Name="nummultiBtn" Content="*" Grid.Row="1" Grid.Column="2" />
                                        <Button x:Name="numminusBtn" Content="-" Grid.Row="1" Grid.Column="3" />
                                        <Button x:Name="voldownBtn" Content="Vol ↓" Grid.Row="1" Grid.Column="4" FontSize="10" />

                                        <Button x:Name="num7Btn" Content="7" Grid.Row="2" Grid.Column="0" />
                                        <Button x:Name="num8Btn" Content="8" Grid.Row="2" Grid.Column="1" />
                                        <Button x:Name="num9Btn" Content="9" Grid.Row="2" Grid.Column="2" />
                                        <Button x:Name="numplusBtn" Content="+" Grid.Row="2" Grid.Column="3" Grid.RowSpan="2" />
                                        <Button x:Name="volmuteBtn" Content="Mute" Grid.Row="2" Grid.Column="4" FontSize="9" />

                                        <Button x:Name="num4Btn" Content="4" Grid.Row="3" Grid.Column="0" />
                                        <Button x:Name="num5Btn" Content="5" Grid.Row="3" Grid.Column="1" />
                                        <Button x:Name="num6Btn" Content="6" Grid.Row="3" Grid.Column="2" />

                                        <Button x:Name="num1Btn" Content="1" Grid.Row="4" Grid.Column="0" />
                                        <Button x:Name="num2Btn" Content="2" Grid.Row="4" Grid.Column="1" />
                                        <Button x:Name="num3Btn" Content="3" Grid.Row="4" Grid.Column="2" />
                                        <Button x:Name="numEnterBtn" Content="Entr" Grid.Row="4" Grid.Column="3" Grid.RowSpan="2" FontSize="8" />

                                        <Button x:Name="num0Btn" Content="0" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" />
                                        <Button x:Name="numPeriodBtn" Content="." Grid.Row="5" Grid.Column="2" />
                                    </Grid>

                                    <Canvas x:Name="mouseCanvas" Width="124" Grid.Column="2" Margin="2 0">
                                        <Canvas.Background>
                                            <ImageBrush ImageSource="{Binding Source={StaticResource resourcePaths}, Path=MousePNG}"/>
                                        </Canvas.Background>

                                        <Button x:Name="mouseUpBtn" Content="↑" Width="20" Height="20" Canvas.Left="50">
                                            <Button.ToolTip>
                                                <TextBlock Text="Upward mouse movement"/>
                                            </Button.ToolTip>
                                        </Button>
                                        <Button x:Name="mouseDownBtn" Content="↓" Width="20" Height="20" Canvas.Left="50" Canvas.Top="138" >
                                            <Button.ToolTip>
                                                <TextBlock Text="Downward mouse movement"/>
                                            </Button.ToolTip>
                                        </Button>
                                        <Button x:Name="mouseLeftBtn" Content="←" Width="20" Height="20" Canvas.Left="0" Canvas.Top="84">
                                            <Button.ToolTip>
                                                <TextBlock Text="Left mouse movement"/>
                                            </Button.ToolTip>
                                        </Button>
                                        <Button x:Name="mouseRightBtn" Content="→" Width="20" Height="20" Canvas.Left="99" Canvas.Top="84">
