<Window x:Class="DS4WinWPF.DS4Forms.BindingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture=""
        lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
        mc:Ignorable="d"
        Title="Select action" Height="580" Width="1120"
        Closing="Window_Closing"
        ResizeMode="NoResize"
        Style="{DynamicResource WindowStyle}"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">
    
    <Window.Resources>
        <local:BindingWinResourcePaths x:Key="resourcePaths" />
        <local:IntToBoolConverter x:Key="IntToBoolConverter" />
    </Window.Resources>
    
    <DockPanel x:Name="fullPanel" Margin="8">
        
        <StackPanel x:Name="extrasSidePanel" Width="260"
                    Orientation="Vertical" DockPanel.Dock="Right">
            <!--<StackPanel.Resources>
                <Thickness x:Key="spaceMargin" Bottom="8" />
            </StackPanel.Resources>-->

            <StackPanel x:Name="extrasGB" Margin="8 0 0 0" Orientation="Vertical">
                <Label Content="{lex:Loc Extra}" FontWeight="Medium" FontSize="15"/>
                <GroupBox Header="{lex:Loc Rumble}">

                    <StackPanel Orientation="Vertical" >
                        <StackPanel Margin="8 0">
                            <Button x:Name="testRumbleBtn" Width="Auto" Content="{lex:Loc Test}" Click="TestRumbleBtn_Click" />
                        </StackPanel>

                        <UniformGrid Rows="2" Columns="2">
                            <Label Grid.Column="0" Content="{lex:Loc Heavy}" Width="50" />
                            <Label Grid.Column="1" Content="{lex:Loc Light}" Width="50" />

                            <xctk:IntegerUpDown Grid.Row="1"
                                                Value="{Binding HeavyRumble}" Minimum="0" Maximum="255" />
                            <xctk:IntegerUpDown Grid.Row="1"
                                                Value="{Binding LightRumble}" Minimum="0" Maximum="255" />
                        </UniformGrid>
                        
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{lex:Loc LightbarMode}" Margin="0 8">
                    <!--<Label Content="{lex:Loc LightbarMode}" />-->
                    <ComboBox x:Name="LightbarModeCombo" SelectedIndex="{Binding Path=LightbarMacro.Active, Converter={StaticResource IntToBoolConverter}}" Width="Auto" Margin="8 0">
                        <ComboBoxItem Content="{lex:Loc SolidColor}" />
                        <ComboBoxItem Content="{lex:Loc Macro}" />
                    </ComboBox>
                </GroupBox>
                <TabControl SelectedIndex="{Binding ElementName=LightbarModeCombo, Path=SelectedIndex}" Style="{DynamicResource HiddenTabControlStyle}"
                            Margin="8 0 8 8">
                        
                    <TabItem Header="{lex:Loc SolidColor}" Visibility="Collapsed">
                        <GroupBox Header="{lex:Loc SolidColor}">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" Margin="8 0">
                                    <CheckBox Content="{lex:Loc BindingWin.ChangeLight}" IsChecked="{Binding UseExtrasColor}"/>
                                    <Button x:Name="extrasColorChoosebtn" Width="30" Height="30" Background="{Binding ExtrasColorString}"
                                            Margin="14 0 0 0"
                                            Click="ExtrasColorChoosebtn_Click"/>
                                </StackPanel>

                                <Border Style="{DynamicResource BorderStyle}" Margin="8 8 8 0" Background="{DynamicResource BackgroundColor}">
                                    <StackPanel >
                                        <StackPanel Orientation="Horizontal">
                                            <Label Content="Red" Width="45"/>
                                            <Slider Value="{Binding ExtrasColorR}" Minimum="0" Maximum="255" ToolTip="{Binding ExtrasColorR}" VerticalAlignment="Center"
                                            MinWidth="100" Background="{Binding ExtrasColorRString, FallbackValue=Red}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" >
                                            <Label Content="Green" Width="45"/>
                                            <Slider Value="{Binding ExtrasColorG}" MinWidth="100" Minimum="0" Maximum="255" VerticalAlignment="Center" ToolTip="{Binding ExtrasColorG}"
                                        Background="{Binding ExtrasColorGString, FallbackValue=Lime}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Label Content="Blue" Width="45"/>
                                            <Slider Value="{Binding ExtrasColorB}"
                                        MinWidth="100" Minimum="0" Maximum="255" 
                                        VerticalAlignment="Center"
                                        ToolTip="{Binding ExtrasColorB}"
                                        Background="{Binding ExtrasColorBString, FallbackValue=Blue}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>
                    </TabItem>
                    
                    <TabItem Header="{lex:Loc Macro}" Visibility="Collapsed">
                        <GroupBox Header="{lex:Loc Macro}">
                            <Button Content="{lex:Loc CreateLightbarMacro}" Click="CreateLightbarMacro_Click" Width="Auto"/>
                        </GroupBox>
                    </TabItem>
                </TabControl>

                <GroupBox Header="Light Flashing" Margin="0 0 0 8">
                    <StackPanel Orientation="Horizontal" >
                        <Label Content="{lex:Loc FlashRate}"/>
                        <xctk:IntegerUpDown MinWidth="50" Value="{Binding FlashRate}" Minimum="0" Maximum="20" />
                        <Label Content="/sec"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox>
                    <GroupBox.Header>
                        <CheckBox Content="{lex:Loc BindingWin.ChangeMouseSensitivity}" IsChecked="{Binding UseMouseSens}" Margin="0"/>
                    </GroupBox.Header>
                    <StackPanel Orientation="Vertical">
                        <xctk:IntegerUpDown Value="{Binding MouseSens}" Width="Auto"  Minimum="0" Maximum="255" />
                    </StackPanel>
                </GroupBox>


            </StackPanel>
        </StackPanel>
        
        <DockPanel x:Name="mapBindingPanel" DockPanel.Dock="Top">
            
            <Border Style="{DynamicResource BorderStyle}" DockPanel.Dock="Top" Margin="0 0 0 8">
                <TabControl x:Name="mapOptionsPanel">

                    <TabItem Header="{lex:Loc BindingWin.KeyAndRelMouse}">
                        <DockPanel Margin="8 8 8 0">
                            <Grid x:Name="topGrid" DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3.9*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.25*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left">
                                    <Label x:Name="macroOnLb" Content="{lex:Loc BindingWin.MacroOn}" Visibility="{Binding MacroLbVisible}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="keyMouseTopTxt" Text="{lex:Loc BindingWin.KeyboardAndMouse}" TextWrapping="Wrap" TextAlignment="Center" 
                                               Foreground="{DynamicResource AccentColorActive}"/>
                                </StackPanel>
                                <StackPanel x:Name="topOptsPanel" Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <CheckBox Content="{lex:Loc Toggle}" IsChecked="{Binding Toggle}" Style="{DynamicResource CheckBoxStyle_Default}"/>
                                    <CheckBox Content="{lex:Loc ScanCode}" IsChecked="{Binding HasScanCode}" Margin="6,0,0,0" Style="{DynamicResource CheckBoxStyle_Default}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button x:Name="recordMacroBtn" Content="{lex:Loc BindingWin.RecordAMacro}" Click="RecordMacroBtn_Click" />
                                </StackPanel>
                            </Grid>

                            <Grid DockPanel.Dock="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <UniformGrid Columns="1" Grid.Column="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.Resources>
