                                        </Grid.ColumnDefinitions>

                                        <Grid.Resources>
                                            <Style x:Key="midMargin" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Margin" Value="2,0,2,0" />
                                                <Setter Property="Width" Value="auto"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </Grid.Resources>

                                        <Button x:Name="lshiftBtn" Content="LShift" Grid.Column="0" Style="{StaticResource midMargin}"/>
                                        <Button x:Name="zBtn" Content="Z" Grid.Column="1" Style="{StaticResource midMargin}"/>
