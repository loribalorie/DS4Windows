                                                <TextBlock Text="Mouse' extra button"/>
                                            </Button.ToolTip>
                                        </Button>
                                        <Button x:Name="mouse5Btn" Content="5" Width="20" Height="20" Canvas.Left="76" Canvas.Top="108">
                                            <Button.ToolTip>
                                                <TextBlock Text="Mouse' extra button"/>
                                            </Button.ToolTip>
                                        </Button>

