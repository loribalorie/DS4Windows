                                        <Button x:Name="sixBtn" Content="6" Grid.Column="6"/>
                                        <Button x:Name="sevenBtn" Content="7" Grid.Column="7"/>
                                        <Button x:Name="eightBtn" Content="8" Grid.Column="8"/>
