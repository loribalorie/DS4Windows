                                        <Button x:Name="yKey" Content="Y" Grid.Column="6"/>
                                        <Button x:Name="uKey" Content="U" Grid.Column="7"/>
                                        <Button x:Name="iKey" Content="I" Grid.Column="8"/>
                                        <Button x:Name="oKey" Content="O" Grid.Column="9"/>
                                        <Button x:Name="pKey" Content="P" Grid.Column="10"/>
                                        <Button x:Name="lbracketBtn" Content="[" Grid.Column="11"/>
